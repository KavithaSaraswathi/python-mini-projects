import random

number = random.randint(1, 20)

print("Guess the number between 1 and 20")
print("You have 5 chances")

for chance in range(5):
    guess = int(input("Enter your guess: "))

    if guess == number:
        print(" You guessed it right!")
        break
    elif guess < number:
        print("Too low ")
    else:
        print("Too high ")

else:
    print(" Game over!")
    print("Correct number was:", number)
