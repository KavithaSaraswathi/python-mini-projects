import random
import string

print("PASSWORD GENERATION\n")
password=[]
char=[]

lower=list(string.ascii_lowercase)
upper=list(string.ascii_uppercase)
num=[1,2,3,4,5,6,7,8,9,0]
symbols=['!','@','#','$','%','^','&','*','?','/']

len_pass=int(input("Enter the length of your required password:"))

use_upper=input("Do you want uppercase letters?(1/0):")
use_lower=input("Do you want lowercase letters?(1/0):")
use_symbol=input("Do you want special characters?(1/0):")
use_num=input("Do you want numbers?(1/0):")

if(use_upper):
    for i in upper:
        char.append(i)
if(use_lower):
    for i in lower:
        char.append(i)
if(use_symbol):
    for i in symbols:
        char.append(i)
if(use_num):
    for i in num:
        char.append(i)   

for i in range(len_pass):
    password.append(random.choice(char))   

print()
print("Here is your password:",end="")
for i in password:
    print(i,end="")
